{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "hypotheses", "unknowns", "evidence_quality_assessment"],
  "properties": {
    "status": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE"]},
    "hypotheses": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cause", "confidence", "evidence_ids", "contradicting_evidence_ids"],
        "properties": {
          "cause": {"enum": ["AUTHENTICATION_FRICTION", "INSUFFICIENT_FUNDS_SIGNAL", "INSTRUMENT_RESTRICTED", "INSTRUMENT_EXPIRED_OR_INVALID", "NETWORK_OR_GATEWAY_TRANSIENT", "METHOD_FRICTION", "MERCHANT_CONFIGURATION", "CUSTOMER_ABORTED", "REPEATED_ATTEMPT_EXHAUSTION", "POSSIBLE_LOW_INTENT", "UNKNOWN"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
          "contradicting_evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
        }
      }
    },
    "unknowns": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 120}},
    "evidence_quality_assessment": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

